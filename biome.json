{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "app/**/*.tsx",
      "components/**/*.tsx",
      "lib/**/*.ts",
      "hooks/**/*.ts",
      "context/**/*.tsx",
      "utils/**/*.ts",
      "server/**/*.ts",
      "!server/db/**/*.ts",
      "!**/*.min.js",
      "!**/*.gen.ts",
      "!**/*.d.ts"
    ]
  }
}
