generator client {
  provider = "prisma-client"
  output   = "../server/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  production
  shipped
  delivered
  cancelled
}

enum ProductType {
  tshirt
  hoodie
  mug
  sticker
  other
}

enum ShirtSize {
  PP
  P
  M
  G
  GG
  XG
  XGG
}

enum DiscountType {
  percentage
  fixed
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  refresh_token_expires_in Int?
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String?
  image          String?
  emailVerified  DateTime?
  cpf            String?
  addresses      Address[]
  orders         Order[]
  cartItems      CartItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  userPromotions UserPromotion[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  recipient  String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  zipCode    String

  createdAt DateTime @default(now())
}

model Product {
  id              String        @id @default(uuid())
  gelatoProductId String?       @unique // Gelato store product ID (set when synced from Gelato)
  sku             String // Internal product reference code
  name            String
  description     String
  type            ProductType
  price           Decimal
  discountType    DiscountType? // percentage or fixed — null means no active discount
  discountAmount  Decimal? // percentage (0–100) or fixed BRL amount
  finalPrice      Decimal? // pre-computed price after applying product-level discount
  active          Boolean       @default(true)

  images     ProductImage[]
  printFiles ProductPrintFile[]
  variants   ProductVariant[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  productPromotions ProductPromotion[]
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  gelatoVariantId String?       @unique // Gelato store variant ID (set when synced from Gelato)
  productUid      String? // Gelato productUid (encodes size + color, used for fulfillment)
  color           String
  size            ShirtSize?
  stock           Int
  price           Decimal?
  discountType    DiscountType? // overrides product-level discount for this specific variant
  discountAmount  Decimal?
  finalPrice      Decimal? // pre-computed price after applying variant-level discount (null → use product.finalPrice)

  createdAt DateTime @default(now())
}

// Customer-facing display images (mockups, lifestyle photos, etc.)
model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  url   String
  alt   String?
  order Int

  createdAt DateTime @default(now())
}

// Print-ready artwork files sent to Gelato for fulfillment
model ProductPrintFile {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  fileType String // Gelato file type: default, front, back, neck-inner, etc.
  url      String // URL to the high-resolution print-ready artwork
  order    Int    @default(0)

  createdAt DateTime @default(now())
}

model Order {
  id      String @id @default(uuid())
  orderId String @unique // Gelato order ID (set after fulfillment submission)
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  status          OrderStatus @default(pending)
  paymentIntentId String?     @unique

  totalQuantity  Int
  subtotal       Decimal
  discountAmount Decimal @default(0)
  shippingPrice  Decimal
  total          Decimal

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id])

  shipping Shipping?
  address  OrderAddress?
  items    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String // Local order ID
  order   Order  @relation(fields: [orderId], references: [id])

  productType ProductType

  productId String
  variantId String?
  name      String
  size      String?
  quantity  Int
  price     Decimal

  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderAddress {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  recipient  String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  zipCode    String

  createdAt DateTime @default(now())
}

model Shipping {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  method      String // PAC, Sedex, J&T
  price       Decimal
  estimatedAt Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId     String
  variantId     String
  name          String
  sku           String
  color         String
  image         String
  price         Decimal
  originalPrice Decimal? // undiscounted price, for display purposes
  quantity      Int
  size          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId])
  @@index([userId])
}

model Promotion {
  id                     String             @id @default(uuid())
  active                 Boolean            @default(true)
  code                   String             @unique
  description            String?
  discountType           DiscountType
  discountAmount         Decimal
  freeShipping           Boolean            @default(false)
  freeShippingMaxAmount  Decimal? // max shipping cost covered; null = fully free
  allowOnDiscountedItems Boolean            @default(true) // if false, coupon skips items with product-level discounts
  limit                  Int? // max total uses across all users
  userLimit              Int? // max uses per user
  minOrderAmount         Decimal?
  maxOrderAmount         Decimal?
  createdAt              DateTime           @default(now())
  expiresAt              DateTime?
  updatedAt              DateTime           @updatedAt
  productPromotions      ProductPromotion[]
  userPromotions         UserPromotion[]
  orders                 Order[]
}

model ProductPromotion {
  productId   String
  promotionId String
  product     Product   @relation(fields: [productId], references: [id])
  promotion   Promotion @relation(fields: [promotionId], references: [id])

  @@unique([productId, promotionId])
}

model UserPromotion {
  userId      String
  promotionId String
  usageCount  Int       @default(0)
  user        User      @relation(fields: [userId], references: [id])
  promotion   Promotion @relation(fields: [promotionId], references: [id])

  @@unique([userId, promotionId])
}
